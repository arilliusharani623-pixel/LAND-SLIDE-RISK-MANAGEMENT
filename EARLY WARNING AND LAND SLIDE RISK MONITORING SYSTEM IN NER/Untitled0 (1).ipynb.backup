      "source": [
        "from ydata_profiling import ProfileReport\n",
        "\n",
        "# --- df_landslide (Global Landslide Catalog) ---\n",
        "print('--- Inspecting df_landslide ---')\n",
        "df_landslide.info()\n",
        "print('\\nGenerating profile report for df_landslide...')\n",
        "profile_landslide = ProfileReport(df_landslide, title=\"Global Landslide Catalog Profile\")\n",
        "profile_landslide.to_widgets()\n",
        "\n",
        "# --- df_rainfall (District-wise Rainfall Normal) ---\n",
        "print('\\n--- Inspecting df_rainfall ---')\n",
        "df_rainfall.info()\n",
        "print('\\nGenerating profile report for df_rainfall...')\n",
        "profile_rainfall = ProfileReport(df_rainfall, title=\"District-wise Rainfall Profile\")\n",
        "profile_rainfall.to_widgets()\n",
        "\n",
        "# --- df_flood (Urban Pluvial Flood Risk Dataset) ---\n",
        "print('\\n--- Inspecting df_flood ---')\n",
        "df_flood.info()\n",
        "print('\\nGenerating profile report for df_flood...')\n",
        "profile_flood = ProfileReport(df_flood, title=\"Urban Pluvial Flood Risk Profile\")\n",
        "profile_flood.to_widgets()\n",
        "\n",
        "# --- df_landslide2 (Additional Landslide Dataset) ---\n",
        "print('\\n--- Inspecting df_landslide2 ---')\n",
        "df_landslide2.info()\n",
        "print('\\nGenerating profile report for df_landslide2...')\n",
        "profile_landslide2 = ProfileReport(df_landslide2, title=\"Additional Landslide Dataset Profile\")\n",
        "profile_landslide2.to_widgets()"
      ]
    },
