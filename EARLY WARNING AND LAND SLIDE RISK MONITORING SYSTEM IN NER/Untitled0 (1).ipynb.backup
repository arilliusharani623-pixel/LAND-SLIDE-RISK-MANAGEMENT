      },
      "source": [
        "## PHASE 1 - DATA ANALYSIS"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "2cfdf56e"
      },
      "source": [
        "### Mount Google Drive"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "b841f507",
        "outputId": "de3cde71-c169-42b0-eb5f-deec524dcab8"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Mounted at /content/drive\n"
          ]
        }
      ],
      "source": [
        "from google.colab import drive\n",
        "drive.mount('/content/drive')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "082f105f"
      },
      "source": [
        "### Load all datasets"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "5f55e6d2",
        "outputId": "83a4db05-bb04-4c36-9311-f20af714e0d3"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n",
            "Landslide Catalog: (11033, 31)\n",
            "Rainfall: (641, 19)\n",
            "Flood Dataset: (2963, 17)\n",
            "Landslide Dataset: (2000, 10)\n"
          ]
        }
      ],
      "source": [
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "base_path = \"/content/drive/MyDrive/\"\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# Landslide Catalog\n",
        "df_landslide = pd.read_csv(\n",
        "    base_path + \"Global_Landslide_Catalog_Export.csv\"\n",
        ")\n",
        "\n",
        "# Rainfall Dataset\n",
        "df_rainfall = pd.read_csv(\n",
        "    base_path + \"district wise rainfall normal.csv\"\n",
        ")\n",
        "\n",
        "# Flood Risk Dataset\n",
        "df_flood = pd.read_csv(\n",
        "    base_path + \"urban_pluvial_flood_risk_dataset.csv\"\n",
        ")\n",
        "\n",
        "# Additional Landslide Dataset\n",
        "df_landslide2 = pd.read_csv(\n",
        "    base_path + \"landslide_dataset.csv\"\n",
        ")\n",
        "\n",
        "print(\"Landslide Catalog:\", df_landslide.shape)\n",
        "print(\"Rainfall:\", df_rainfall.shape)\n",
        "print(\"Flood Dataset:\", df_flood.shape)\n",
        "print(\"Landslide Dataset:\", df_landslide2.shape)"
      ]
    },
    {
